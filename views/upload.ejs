<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>File Upload</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/upload.css">

</head>
<body>
    <a class="homeBtn" href="/">Home</a>
    
    <div class="appendFiles">
        <h3 class="appendFilesTitle">Files Chosen:</h3>
        <h3 class="reset" onmousedown= window.location.reload()>Reset</h3>

    </div>
    
    <h3 class="uploadBtn">Upload</h3>

    <form action="/upload" method="post" enctype="multipart/form-data" class="dropZone">
        <div class="header">
            <h1 class="fileUpload">File Upload:</h1>
            <h3 class="instruct">Drag and drop your file(s) to this box.</h3>
            
            <img id="dropIcon" class="add" src="/icons/add.png" alt="add files">

        </div>
        <input type="file" multiple onchange=console.log(event.target.files)>
      
    </form>
            
     

    <div class="alert" hidden>
        <h1 class="alertMessage"></h1>
    </div>



</body>
<script>
document.addEventListener('DOMContentLoaded', () => {
    const dropZone = document.querySelector('.dropZone')
    const form = document.querySelector('.dropZone')

    const uploadBtn = document.querySelector('.uploadBtn')
    
    const fileListContainer = document.querySelector('.appendFiles')
    const addIcon = document.querySelector('.add')
    const alert = document.querySelector('.alert')
    const alertMessage = document.querySelector('.alertMessage')

    let formData = new FormData()
    let rejectedFiles = []

    // Prevent file open on page drop
    document.body.addEventListener('dragover', (e) => e.preventDefault())
    document.body.addEventListener('drop', (e) => {
        e.preventDefault()
        e.stopPropagation()
        hideIcons()
    })

    dropZone.addEventListener('dragover', (e) => {
        e.preventDefault()
        e.stopPropagation()
        addIcon.style.display = 'block'
    })

    dropZone.addEventListener('drop', (event) => {
        event.preventDefault()
        event.stopPropagation()

        const dt = event.dataTransfer
        const files = dt.files
        console.log(files)
        if (!dt || !files || files.length === 0) {
            console.warn('No files detected in drop.')
            return
        }

        for (let file of files) {
            if (file.name.length < 55) {
                formData.append('fileUpload', file)
                displayFile(file.name)
            } else {
                rejectedFiles.push(file.name)
            }
        }

        if (rejectedFiles.length > 0) {
            alertRejectedFiles(rejectedFiles)
        }

        uploadBtn.style.display = 'block'
        hideIcons()
    })

    uploadBtn.addEventListener('click', (event) => {
        event.preventDefault()

        fetch(form.action, {
            method: form.method,
            body: formData
        }).then(response => {
            alert.style.display = 'block'
            if (response.ok) {
                alert.style.background = 'rgb(2, 39, 250)'
                alertMessage.textContent = 'Success! Redirecting Home.'
                setTimeout(() => document.querySelector('.homeBtn').click(), 1000)
            } else {
                alert.style.background = 'rgb(180, 3, 3)'
                alertMessage.textContent = 'Upload failed.'
                setTimeout(() => {
                    alert.style.display = 'none'
                    alertMessage.textContent = ''
                }, 2500)
            }
        }).catch(err => {
            console.error("Upload error:", err)
        })
    })

    function displayFile(fileName) {
        const listItem = document.createElement('li')
        listItem.className = 'fileListItem'

        const fileNameEl = document.createElement('p')
        fileNameEl.className = 'fileName'
        fileNameEl.textContent = fileName

        const fileIcon = document.createElement('img')
        fileIcon.className = 'fileIcon'
        fileIcon.src = pairFileIcon(fileName)

        listItem.append(fileIcon, fileNameEl)
        fileListContainer.appendChild(listItem)
    }

    function alertRejectedFiles(rejectedFiles) {
        alert("The following file(s) need shorter names:\n" + rejectedFiles.join('\n'))
    }

    function hideIcons() {
        addIcon.style.display = 'none'
    }

    function pairFileIcon(fileName) {
        const fileImgSrc = {
            pdf: '/icons/pdf.png',
            css: '/icons/css.png',
            html: '/icons/html.png',
            js: '/icons/js.png',
            jpg: '/icons/photo.png',
            jpeg: '/icons/photo.png',
            png: '/icons/photo.png',
            mp4: '/icons/video.png',
            mov: '/icons/video.png',
            avi: '/icons/video.png',
            wmv: '/icons/video.png',
            doc: '/icons/doc.png',
            docx: '/icons/doc.png',
            odt: '/icons/doc.png',
            rtf: '/icons/doc.png',
            xls: '/icons/xl.png',
            xlsx: '/icons/xl.png',
            xlm: '/icons/xl.png',
            ods: '/icons/xl.png',
            csv: '/icons/xl.png',
            tsv: '/icons/xl.png'
        }

        const ext = fileName.split('.').pop().toLowerCase()
        alert(ext)
        return fileImgSrc[ext] || '/icons/default.png'
    }

    // Reset handler
    const resetBtn = document.querySelector('.reset')
    resetBtn.addEventListener('mousedown', () => window.location.reload())
})
</script>

</html>