<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>File Upload</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/upload.css">

</head>
<body ondrop=handleBody(event) ondragover=handleDragOver(event)>
    <a class="homeBtn" href="/">Home</a>
    
    <div class="appendFiles">
        <img id="dropIcon" class="add" src="/icons/add.png" alt="add files">

        <h3 class="appendFilesTitle">Files Chosen:</h3>
    </div>
    
    <h3 class="uploadBtn">Upload</h3>

    <form action="/upload" method="post" enctype="multipart/form-data" class="dropZone" ondrop=handleDrop(event) >
        <div class="header">
            <h1 class="fileUpload">File Upload:</h1>
            <h3 class="instruct">Drag and drop your file(s) to the box below.</h3>
            
        </div>
        <h3 class="reset" onmousedown= window.location.reload()>Reset</h3>
      
        


    </form>
            

    <div class="alert">
        <h1 class="alertMessage"></h1>
    </div>



</body>
<script>
    function handleBody(event){
        event.preventDefault()
        hideIcons()
    }
    function handleDrop(event) {
        event.preventDefault()
        console.log('dropped')
        const files = event.dataTransfer.files
        const form = document.querySelector('.dropZone')

        let rejectedFiles = []

        const formData = new FormData(form)
        for (let file of files) {
            if(file.name.length < 55){
                console.log(file)
                formData.append('fileUpload', file) 
            }
            else{
                rejectedFiles.push(file.name)
            }
          
            
            displayFile(file.name)
           
        }
        if(rejectedFiles.length > 0){ rejectedFileAlert(rejectedFiles)}

        // Submit when button clicks
        const uploadBtn = document.querySelector('.uploadBtn')
        uploadBtn.style.display = 'block'
        

        uploadBtn.addEventListener('click', () =>{
            event.preventDefault()
            const fileList = document.querySelector('.fileList')

            fetch(form.action, {
                method: form.method,
                body: formData
            }).then(response => {
                 const alert = document.querySelector('.alert')
                    alert.display = 'block'
                const alertMessage = document.querySelector('.alertMessage')  
                if (response.ok) {
                    alert.style.background = 'rgb(2, 39, 250)'
                    alertMessage.textContent = 'Success! Redirecting Home.'

                    setTimeout(() => {
                        const homeBtn = document.querySelector('.homeBtn')
                        homeBtn.click()
                    },1000)

                    // Optionally reset form or update UI
                } else {
                    alert.textContent = 'alertMessage'
                    alert.style.background = 'rgb(180, 3, 3)'
                    setTimeout(() => {
                        alert.style.display = 'hidden' 
                        alertMessage.textContent = ''
                    },2500)
                }
            }).catch(error => {
                console.error("Upload error:", error)
            })
        })
        

        hideIcons()
    }
    
    function rejectedFileAlert(rejectedFiles){
        alert("The Following file(s) need shorter names: " + rejectedFiles)
    }

 

    function displayFile(file){
        // const fileList = document.querySelector('.fileList')
        const fileList = document.querySelector('.appendFiles')

        const listItem = document.createElement('li')
            listItem.className = 'fileListItem'
         
        const fileName = document.createElement('p')
            fileName.className = 'fileName'
            fileName.textContent = file
        
        const fileIcon = document.createElement('img')
            fileIcon.className = 'fileIcon'
            fileIcon.src = pairFileIcon(file)

        listItem.append(fileIcon, fileName)
        fileList.appendChild(listItem)
    }
    function handleDragOver(event){
        event.preventDefault()
    }

    function hideIcons(){
        const add = document.querySelector('.add')
        add.style.display = 'none'
    }

    const dropZone = document.querySelector('.dropZone')
    dropZone.addEventListener('dragenter', (event) =>  {
        event.preventDefault()
    
        const add = document.querySelector('.add')
        add.style.display = 'block'
      
    })

    function pairFileIcon(file){ //called before render to assign img src
        const fileImgSrc = { 
            pdf: '/icons/pdf.png',
            css: '/icons/css.png',
            html: '/icons/html.png',
            js: '/icons/js.png',

            jpg: '/icons/photo.png',
            jpeg: '/icons/photo.png',

            mp4: '/icons/video.png',
            mov: '/icons/video.png',
            avi: '/icons/video.png',
            wmv: '/icons/video.png',

            
            doc: '/icons/doc.png',
            docx: '/icons/doc.png',
            odt: '/icons/doc.png', 
            rtf: '/icons/doc.png',

            xls: '/icons/xl.png',
            xlsx: '/icons/xl.png',
            xlm: '/icons/xl.png',
            ods: '/icons/xl.png', 
            csv: '/icons/xl.png',
            tsv: '/icons/xl.png',  
       }
        const fileType = file.split('.')[1].toLowerCase() 
        return fileImgSrc[fileType] ? fileImgSrc[fileType] : '/icons/default.png'       
    }
  

</script>
</html>