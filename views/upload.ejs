<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>File Upload</title>
</head>
<body>
    <h1 class="fileUpload">File Upload:</h1>
    <h3 class="storageSpace">You have __/5GB of storage left.</h3>
    <form action="/upload" method="post" enctype="multipart/form-data">
        <label for="file">Upload File</label>
        <input type="file" name="fileUpload" class="fileUpload" multiple required onchange=console.log(event.target.file)>
        <button class="submit">Upload</button>
    </form>
</body>
</html>