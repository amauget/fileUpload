<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <link rel="stylesheet" href="/stylesheets/style.css">
    <title>Action Unsuccessful</title>
</head>
<body>

        <div class="alert">
            <h1 class="title">Your Attempt Has Been Unsuccessful</h1>
            <h2 class="label">Here's Why:</h2>
            <p class="message"><%= message %></p>
            <a class="okay" href="/">Okay</a>
        </div>

   
</body>
<style>
    :root,body{
        padding: 0;
        margin: 0;
        background-color: rgb(211, 211, 211);
        display: grid;
        justify-content: center;
        height: 100vh;
        width: 100vw;
    }
    .alert{
        min-height: 30vh;
        width: 50vw;
        background-color: white;
        align-self: center;
        padding:1rem;
        display:grid;
    }
        .title{
            color: red;
            text-align: center;
        }
        .okay{
            justify-self: center;
            font-size: 1.6rem;
            text-decoration: none;
            background-color: rgb(90, 90, 255);
            padding: 1vh;
            color: black;
            border-radius: 15px;
        }
@media(max-width: 950px){
    .alert{
        width: 75vw;
        text-align: center;
    }
}
</style>
</html>