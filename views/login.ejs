<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/registerLogin.css">

    <title>Log in</title>
</head>
<body>
    <div class="header">
        <a class="home" href="/">Go Home</a>
        <h4 class="dontHaveAccount">Don't Have an Account? Click <a class="registerLink" href="/register">Here</a> to Register.</h4>

    </div>

    <form class="login" action="/login" method="post">
        <h1 class="loginTitle">Log in</h1>

        <label for="usernameLabel">Username</label>
        <input type="text" name="username" required onkeydown=preventChars()>
        <label for="password">Password: </label>
        <input type="password" name="password" required onkeydown=preventChars()>

        <button class="submit">submit</button>
    </form>
        <h3 style="color:red"><%=message%></h3>


</body>
<script>
    function preventChars(){
        const unsafeChars = ["'", '"', '>', '<', '&']
        if(unsafeChars.filter(char => {return char === event.key}).length > 0){
            event.preventDefault()
            renderCharQueue()
        }
    }

    function renderCharQueue(){
        if(! document.querySelector('.charQueue')){
            const body = document.querySelector('body')
            const charQueue = document.createElement('p')
            charQueue.className = 'charQueue'
            charQueue.textContent = `Characters: "'", '"', '>', '<', '&' are not allowed.`
            
            body.appendChild(charQueue)
        }
    }
</script>
</html>