<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Success!</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
     <link rel="stylesheet" href="/stylesheets/home.css">


</head>
<body>
      <%if(user.username){%>
        <div class="headerLoggedIn">
            <div class="userContainer">
                <img class="profileIcon" src="/icons/profile.png" alt="profileIcon">
                <h2 class="userName"><%=user.displayedUsername%></h2>
            </div>
            <a class="deleteSelector" href="/delete">Delete Files</a>

            <h3 class="uploadSelector" onclick=displayUploadForm()>Upload Files</h3>

            <a class="logoutSelector" href="/logout">Log Out</a>
        </div>
     <%}%>
    <h1>Success!</h1>
    <h2>Your files have uploaded. Refreshing your file list.</h2> <a class="link" href="/" hidden></a> 
    <div class="loader"></div>
</body>
<script>setTimeout(() => {document.querySelector('.link').click()}, 1500)</script>
<style>
    .loader{
        display: block;
    }
</style>
</html>