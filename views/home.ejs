<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/home.css">
    <title>Home Page</title>
</head>
<body>
    
    <%if(user.username){%>
        <h2 class="welcome">Welcome, <%=user.displayedUsername%>!</h2>
        <a href="/logout">Log Out</a>
        <a href="/upload">Upload Files</a>

        <%if(files.length === 0){%>
            <h3>You have no uploaded files </h3>
        <%}else{%>
            <h3>You have <%=5 - user.usedStorage/(1000 **3)%>GB of remaining storage</h3>
            <h3>Your files:</h3>
        <%}%>

        <input type="text" class="search" placeholder="search your files" onkeyup=searchFiles()>
        <% if(files.length > 0){%>
            
                <form action="/download" method="POST" class="downloadForm">
                    <h2 class="formTitle">Select Files to Download</h2>
                    <% files.map(file => { %>
                        <div class="fileContainer" id="<%=file%>">
                            <img id="fileIcon" src=<%=pairFileIcon(file)%> alt="file icon">
                            <label for="<%=file%>" id="file"><%=file%></label>
                            <input type="radio" name="<%=file%>" id="<%=file%>" onmousedown=toggleRadio() onclick=event.preventDefault()>
                        </div>
                    <% }) %>
                    <button class="downloadBtn" onclick=evalFormRadios()>Download</button>
    
                </form>
                
           
        <% } %>
       

    <%}else{%>
        <h1>Home</h1>
        <a href="/login">Login</a>
        <a href="/register">Register</a>
    <%}%>

    <% function pairFileIcon(file){ //called before render to assign img src
        const fileImgSrc = { 
            jpg: '/icons/jpg.png',
            jpeg: '/icons/jpg.png',
            pdf: '/icons/pdf.png',
            css: '/icons/css.png',
            html: '/icons/html.png',
            js: '/icons/js.png',
            
            doc: '/icons/doc.png',
            docx: '/icons/doc.png',
            odt: '/icons/doc.png', 
            rtf: '/icons/doc.png',

            xls: '/icons/xl.png',
            xlsx: '/icons/xl.png',
            xlm: '/icons/xl.png',
            ods: '/icons/xl.png', 
            csv: '/icons/xl.png',
            tsv: '/icons/xl.png',  
       }
        const fileType = file.split('.')[1].toLowerCase() 
        return fileImgSrc[fileType] ? fileImgSrc[fileType] : '/icons/default.png'       
    }%>
    
</body>
<script>
    function searchFiles(){
        const files = document.querySelectorAll('#file')

        for(let i of files){
            const fileName = i.textContent.toLowerCase()
            const fileContainer = document.getElementById(i.textContent)
            const fileRadio = fileContainer.querySelector('input')

           if(fileName.includes(event.target.value.toLowerCase()) || fileRadio.checked){
                fileContainer.style.display = 'block'
           }
           else{
                fileContainer.style.display = 'none'
           }
        }
    }
    function toggleRadio(){
        if(event.target.checked === true){
           return event.target.checked = false
        }
        return event.target.checked = true
    }

    function evalFormRadios(){ //ensures that at least 1 radio is selected to submit form
        event.preventDefault()
        const downloadForm = document.querySelector('.downloadForm')
        const radios = downloadForm.querySelectorAll('input')

        for(let i = 0; i < radios.length; i++){
            if(radios[i].checked){
                downloadForm.submit()
                break
            }
        }
    }
 
    
</script>
</html>