<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/home.css">
    <script type="text/javascript" src="/scripts/search.js"></script>
    <script type="text/javascript" src="/scripts/previewFile.js"></script>
    <script type="text/javascript" src="/scripts/radioHandlers.js"></script>

    <title>Home Page</title>
</head>
<body>
        <div class="headerLoggedIn">
            <div class="userContainer">
                <img class="profileIcon" src="/icons/profile.png" alt="profileIcon">
                <h2 class="userName"><%=user.displayedUsername%></h2>
            </div>
            <a class="deleteSelector" href="/delete">Delete Files</a>

            <h3 class="uploadSelector" onclick=displayUploadForm()>Upload Files</h3>

            <a class="logoutSelector" href="/logout">Log Out</a>
        </div>
     
    <div class="bodyContainer">
        <%if(files.length === 0){%>
            <h3>You have no uploaded files </h3>
        <%}else{%>
            <h3 class="userSpace">You have <%=(5 - user.usedStorage/(1000 **3)).toFixed(2)%>GB of remaining storage</h3>

        <%}%>

        <% if(files.length > 0){%>
            <div class="formComponentContainer">
                <h2 class="formTitle">Select Files to Download</h2>
                <input type="text" class="search" placeholder="search your files" onkeyup=searchFiles(event)>

                <form action="/download" method="POST" class="downloadForm" >
                    <% files.map(file => { %>
                        <div class="fileContainer" id="<%=file%>">
                            <div class="imgContainer">
                                <img id="fileIcon" src=<%=pairFileIcon(file)%> alt="file icon" onclick=previewFile()>
                                <p class="preview">preview</p>
                            </div>
                            <div class="radioSelectContainer" onmousedown=toggleRadio() onclick=event.preventDefault()>
                                <label for="<%=file%>" id="fileLabel"><%=file%></label>
                                <input class="fileRadio" type="radio" name="<%=file%>" id="<%=file%>">
    
                            </div>
                        </div>
                    <% }) %>    
                </form>
                <button class="downloadBtn" onclick=evalFormRadios(event)>Download</button>

            </div>

            <div class="filePrevContainer">
                <h2 class="filePrevTitle">File Previewer (PDF, Images, and Video Only)</h2>
                <div class="filePreview">
                             <div id="previewLoader" class="loader"></div>

                </div>
            </div>
           
        <% } %>
    </div>


    <% function pairFileIcon(file){ //called before render to assign img src
        const fileImgSrc = { 
            pdf: '/icons/pdf.png',
            css: '/icons/css.png',
            html: '/icons/html.png',
            js: '/icons/js.png',

            jpg: '/icons/photo.png',
            jpeg: '/icons/photo.png',
            png: '/icons/photo.png',
            svg: '/icons/photo.png',
            webp: '/icons/photo.png',

            mp4: '/icons/video.png',
            mov: '/icons/video.png',
            avi: '/icons/video.png',
            wmv: '/icons/video.png',

            
            doc: '/icons/doc.png',
            docx: '/icons/doc.png',
            odt: '/icons/doc.png', 
            rtf: '/icons/doc.png',

            xls: '/icons/xl.png',
            xlsx: '/icons/xl.png',
            xlm: '/icons/xl.png',
            ods: '/icons/xl.png', 
            csv: '/icons/xl.png',
            tsv: '/icons/xl.png',  
       }
        const fileType = file.split('.')[1].toLowerCase() 
        return fileImgSrc[fileType] ? fileImgSrc[fileType] : '/icons/default.png'       
    }%>
        <div class="uploadContainer">
            <div class="fileListContainer">
                <h3 class="appendFilesTitle">Files Chosen:</h3>
                <h3 class="reset" onclick=resetUploads()>Reset</h3>
                <div class="fileList">

                </div>
            </div>
            <form action="/upload" method="POST" class="uploadForm" enctype="multipart/form-data">
                <label class="inputLabel" for="fileInput">Upload Files Here:</label>
                <h3 class="chooseFiles" onclick=handleInput(event)>Choose Files</h3>
            </form>
            <button class="uploadBtn" hidden onclick=submitFiles()>Upload Files</button>
            <button class="exit" onclick=hideUploadForm()>X</button>
        </div>
</body>
<script>
    const uploadContainer = document.querySelector('.uploadContainer')

    const uploadForm = document.querySelector('.uploadForm')
    const chooseFiles = document.querySelector('.chooseFiles')
    
    const uploadBtn = document.querySelector('.uploadBtn')

    const fileList = document.querySelector('.fileList')

    let fileName = 'fileInput'
    let increment = 1
    

    
    function handleInput(event){
        const newFileInput = document.createElement('input')
        newFileInput.type = 'file'
        newFileInput.multiple = true
        newFileInput.required = true
        newFileInput.name = `${fileName}${increment}`
        newFileInput.id = `${fileName}${increment}`
        newFileInput.style.display = 'none'
        increment++ 
        
        uploadForm.appendChild(newFileInput)


        newFileInput.click()
        listenInputs(newFileInput.id, uploadForm)
    }

    async function listenInputs(id, parent){
        const input = document.querySelector('#' + id)
        input.addEventListener('change', (e) => {
            const fileNames = safeFileNames(input.files)
            if(fileNames.length > 0){
                displayFile(input.files)
                if(input.files){
                    uploadBtn.style.display = 'block'
                }
            }
            else{
                uploadForm.removeChild(input)
            }

       
        })
    }
      function safeFileNames(files){
        const fileNames = []
        for(let i = 0; i < files.length; i ++){
            if(htmlEscape(files[i].name) !== files[i].name){
                alert(`This file contains the following character(s): ( &, ", ', <, > ). Please remove these from your file name and try again. `)
                return []
            }
            fileNames.push(files[i].name)
        }
        return fileNames
    }
    function htmlEscape(text) {
        return text
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;")
    }

    function displayFile(fileNames) {
        for(let i = 0; i < fileNames.length; i++){
            const fileName = fileNames[i].name
      

            const listItem = document.createElement('li')
            listItem.className = 'fileListItem'

            const fileNameEl = document.createElement('p')
            fileNameEl.className = 'fileName'
            fileNameEl.textContent = fileName

            const fileIcon = document.createElement('img')
            fileIcon.className = 'fileIcon'
            fileIcon.src = pairFileIcon(fileName)

            listItem.append(fileIcon, fileNameEl)
            fileList.appendChild(listItem)
        }
    }
        function pairFileIcon(fileName) {
        const fileImgSrc = {
            pdf: '/icons/pdf.png',
            css: '/icons/css.png',
            html: '/icons/html.png',
            js: '/icons/js.png',
            jpg: '/icons/photo.png',
            jpeg: '/icons/photo.png',
            png: '/icons/photo.png',
            mp4: '/icons/video.png',
            mov: '/icons/video.png',
            avi: '/icons/video.png',
            wmv: '/icons/video.png',
            doc: '/icons/doc.png',
            docx: '/icons/doc.png',
            odt: '/icons/doc.png',
            rtf: '/icons/doc.png',
            xls: '/icons/xl.png',
            xlsx: '/icons/xl.png',
            xlm: '/icons/xl.png',
            ods: '/icons/xl.png',
            csv: '/icons/xl.png',
            tsv: '/icons/xl.png'
        }

        const ext = fileName.split('.').pop().toLowerCase()
        return fileImgSrc[ext] || '/icons/default.png'
    }
    function displayUploadForm(){
        uploadContainer.style.display = 'grid'
    }
    function hideUploadForm(){
        uploadContainer.id = 'hideUploadContainer'
        setTimeout(() => {
            resetUploads() //cancel upload form before hiding
            uploadContainer.style.display = 'none' 
            window.Request
            uploadContainer.id = ''
        },500);
  
    }
    function resetUploads(){
        fileList.innerHTML = ''
        
        increment = 1

        uploadForm.innerHTML = ' <label class="inputLabel" for="fileInput">Upload Files Here:</label> <h3 class="chooseFiles" onclick=handleInput(event)>Choose Files</h3>'

        uploadBtn.style.display = 'none'
    }
    function submitFiles(){
        uploadForm.submit()
    }        
</script>

</html>


