<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
</head>
<body>
    
    <%if(user.username){%>
        <h2 class="welcome">Welcome, <%=user.displayedUsername%>!</h2>
        <a href="/logout">Log Out</a>
        <a href="/upload">Upload Files</a>

        <%if(files.length === 0){%>
            <h3>You have no uploaded files </h3>
        <%}else{%>
            <h3>Your files:</h3>
        <%}%>

        <input type="text" class="search" placeholder="search your files" onkeyup=searchFiles()>
        <% if(files.length > 0){%>
            
                <form action="/download" method="POST">
                    <h2 class="formTitle">Select Files to Download</h2>
                    <% files.map(file => { %>
                        <div class="fileContainer">
                            <label for="<%=file%>" id="file"><%=file%></label>
                            <input type="radio" name="<%=file%>" id="<%=file%>">
                        </div>
                    <% }) %>
                    <button class="downloadBtn">Download</button>
    
                </form>
                
           
        <% } %>
       

    <%}else{%>
        <h1>Home</h1>
        <a href="/login">Login</a>
        <a href="/register">Register</a>
    <%}%>


    
</body>
<script>
    function searchFiles(){
        const files = document.querySelectorAll('#file')

        for(let i of files){
            const fileName = i.textContent.toLowerCase()
            const fileRadio = document.getElementById(i.textContent)

           if(fileName.includes(event.target.value.toLowerCase())){
                i.style.display = 'block'
                fileRadio.style.display = 'block'
           }
           else{
                i.style.display = 'none'

                fileRadio.style.display = 'none'
           }
        }
    }
</script>
</html>