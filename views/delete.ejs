<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delete Files</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/home.css">
    <link rel="stylesheet" href="/stylesheets/delete.css">
    <script type="text/javascript" src="/scripts/search.js"></script>
    <script type="text/javascript" src="/scripts/previewFile.js"></script>
    <script type="text/javascript" src="/scripts/radioHandlers.js"></script>
    <script type="text/javascript" src="/scripts/deleteHandlers.js"></script>

</head>
<body>
    <%if(user.username){%>
        <div class="headerLoggedIn" id="deleteHeader">
            <a href="/" class="userContainer">
                <img class="profileIcon" src="/icons/profile.png" alt="profileIcon">
                <h2 class="userName"><%=user.displayedUsername%></h2>
            </a>

            <a class="logoutSelector" href="/logout">Log Out</a>
        </div>
     
    <div class="bodyContainer">
        <%if(files.length === 0){%>
            <h3 style="color: red;">You have no uploaded files to Delete.</h3>
            <p>Click your file icon or username to go home.</p>
        <%}else{%>
            <h3 class="userSpace">You have <%=(5 - user.usedStorage/(1000 **3)).toFixed(2)%>GB of remaining storage</h3>

        <%}%>

        <% if(files.length > 0){%>
            <div class="formComponentContainer">
                <h2 class="formTitle" style="color:rgb(255, 0, 0); justify-self: center;">Select Files to DELETE</h2>
                <input type="text" class="search" placeholder="search your files" onkeyup=searchFiles(event)>

                <form action="/delete" method="POST" id="deleteForm" class="downloadForm" >
                    <% files.map(file => { %>
                        <div class="fileContainer" id="<%=file%>">
                            <div class="imgContainer">
                                <img id="fileIcon" src=<%=pairFileIcon(file)%> alt="file icon" onclick=previewFile()>
                                <p class="preview">preview</p>
                            </div>
                            <div class="radioSelectContainer" onmousedown=toggleRadioDelete(event) >
                                <label for="<%=file%>" id="fileLabel"><%=file%></label>
                                <input class="fileRadio" type="radio" name="<%=file%>" id="<%=file%>">
    
                            </div>
                        </div>
                    <% }) %>    
                </form>
                <button id="deleteBtn" class="downloadBtn" style="background-color:red" onclick=renderAreYouSure(event)>Delete</button>

            </div>

            <div class="filePrevContainer">
                <h2 class="filePrevTitle" style="color: red;">Delete Page File Previewer (PDF, Images, and Video Only)</h2>
                <div class="filePreview">
                   
                </div>
            </div>
            <div class="blocker">
                <div class="areYouSure" >
                    <h2>Are you sure you want to delete these files?</h2>
                    <ul class="deleteList">
    
                    </ul>
                    <div class="confirmationContainer">
                        <p class="yes" onclick=submit()>Yes</p>
                        <p class="no" onclick=hideAreYouSure()>No</p>
                    </div>
                 
                </div>
            </div>
          <div class="loader"></div>
           
        <% } %>
    </div>

  
       

    <%}else{%>
        <div class="headerNoLogin">
            <h1>Home</h1>
            <a href="/login">Login</a>
            <a href="/register">Register</a>
        </div>
     
    <%}%>
    <% function pairFileIcon(file){ //called before render to assign img src
        const fileImgSrc = { 
            pdf: '/icons/pdf.png',
            css: '/icons/css.png',
            html: '/icons/html.png',
            js: '/icons/js.png',

            jpg: '/icons/photo.png',
            jpeg: '/icons/photo.png',
            png: '/icons/photo.png',
            svg: '/icons/photo.png',

            mp4: '/icons/video.png',
            mov: '/icons/video.png',
            avi: '/icons/video.png',
            wmv: '/icons/video.png',

            
            doc: '/icons/doc.png',
            docx: '/icons/doc.png',
            odt: '/icons/doc.png', 
            rtf: '/icons/doc.png',

            xls: '/icons/xl.png',
            xlsx: '/icons/xl.png',
            xlm: '/icons/xl.png',
            ods: '/icons/xl.png', 
            csv: '/icons/xl.png',
            tsv: '/icons/xl.png',  
       }
        const fileType = file.split('.')[1].toLowerCase() 
        return fileImgSrc[fileType] ? fileImgSrc[fileType] : '/icons/default.png'       
    }%>

    
</body>

</html>