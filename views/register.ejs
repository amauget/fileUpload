<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/registerLogin.css">
    <title>Register</title>
</head>
<body>
    <div class="header">
        <a class="home" href="/">Go Home</a>
        <h4 class="haveAccount">Already Have an Account? Click <a class="loginLink" href="/login">Here</a> to Log In.</h4>

    </div>
   
    <form class="register" action="/register" method="post">
        <h1 class="registerTitle">Register</h1>

        <label class="usernameLabel" for="username">Username</label>
        <input type="text" name="username" required onkeydown=preventChars()>
        <label class="passwordLabel" for="password">Password: </label>
        <input class="password" type="password" name="password" required onkeydown=preventChars()>
        
        <label class="secondPasswordLabel" for="secondPassword">Re-Enter Password:</label>
        <input class="secondPassword" type="password" name="secondPassword" required onkeydown=preventChars()>

        <button class="submit">submit</button>
    </form>
     <h2 style="color: red"><%=message%></h2>
</body>
<script>
    function preventChars(){
        const unsafeChars = ["'", '"', '>', '<', '&']
        if(unsafeChars.filter(char => {return char === event.key}).length > 0){
            event.preventDefault()
            renderCharQueue()
        }
    }

    function renderCharQueue(){
        if(! document.querySelector('.charQueue')){
            const body = document.querySelector('body')
            const charQueue = document.createElement('p')
            charQueue.className = 'charQueue'
            charQueue.textContent = `Characters: "'", '"', '>', '<', '&' are not allowed.`
            
            body.appendChild(charQueue)
        }
    }
  
        
</script>

</html>